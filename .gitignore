# ========================================================================
#                    APISout Repository GitIgnore 
# ========================================================================

# 1. Protect Proprietary Human-Readable Code Files 
engine_core.py
transformer.py
apisout_watcher.py

# 2. Python System Cache & Local Environments
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
env/
venv/
.env

# 3. Local Operational Storage Zones
drop_zone/*
normalized_output/*

# 4. Compiled Distribution Asset Archives
*.zip
*.tar
*.tar.gz

# 5. OS and Bloat Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
